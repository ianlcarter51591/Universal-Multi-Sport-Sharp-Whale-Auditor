# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> Settings -> Secrets.
ODDS_API_KEY = "your-the-odds-api-key"

# Optional: permanent storage for line history and the signal log (a classic GitHub token with ONLY the "gist" permission).
# Without it the app still works, but saved data is lost whenever Streamlit Cloud restarts the app.
GITHUB_GIST_TOKEN = "ghp_your_token_here"
